# QueryMind Backend — Development .env
# Fill in your actual values before running

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/querymind

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

DEBUG=true
ENVIRONMENT=development

MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
MAX_SCHEMA_TABLES_TO_GEMINI=20


SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

OPENAI_API_KEY=sk-proj-your_actual_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

